{
  // Mica Glass palette, same colours as the Windows Terminal scheme and Starship prompt
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "Windows 11_small",
    "color": { "1": "38;2;148;203;137", "2": "38;2;148;203;137", "3": "38;2;148;203;137", "4": "38;2;148;203;137" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;148;203;137", "title": "38;2;148;203;137" },
    "key": { "width": 14 }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "\u2500" },
    { "type": "os", "key": "\uf17a  os" },
    { "type": "kernel", "key": "\uf013  kernel" },
    { "type": "uptime", "key": "\uf017  uptime" },
    { "type": "packages", "key": "\uf487  packages" },
    { "type": "shell", "key": "\uf489  shell" },
    { "type": "terminal", "key": "\ue795  terminal" },
    { "type": "terminalfont", "key": "\uf031  font" },
    { "type": "wm", "key": "\uf2d2  wm", "format": "{plugin-name}" },
    { "type": "cpu", "key": "\uf4bc  cpu" },
    { "type": "gpu", "key": "\uf108  gpu", "hideType": "unknown", "format": "{name}" },
    { "type": "memory", "key": "\udb80\udf5b  memory" },
    { "type": "disk", "key": "\uf0a0  disk", "folders": "C:\\" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
