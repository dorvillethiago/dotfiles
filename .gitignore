# ignore everything at the top level
/*
!/.gitignore

# allow .config, but ignore everything inside it by default
!/.config
/.config/*

# then whitelist what you want
!/.config/yasb
/.config/yasb/*
!/.config/yasb/styles.css
!/.config/yasb/config.yaml
!/.config/yasb/connection.cmd
!/.config/whkdrc
!/.config/starship.toml
!/.config/fastfetch
/.config/fastfetch/*
!/.config/fastfetch/config.jsonc
!komorebi.json
!applications.json
!win.ahk
!README.md
!.gitattributes
!setup.ps1
!bootstrap.ps1
!link.ps1
!update.ps1
!.gitconfig
!windows-terminal
/windows-terminal/*
!/windows-terminal/settings.json

# PowerShell 7 profile
!/powershell
/powershell/*
!/powershell/profile.ps1

# .claude — track authored files only, block everything else
!/.claude
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.json
!/.claude/commands
/.claude/commands/*
!/.claude/commands/task.md
!/.claude/skills
/.claude/skills/*
!/.claude/skills/pr-description
/.claude/skills/pr-description/*
!/.claude/skills/pr-description/SKILL.md