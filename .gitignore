# ignore everything at the top level
/*
!/.gitignore

# allow .config, but ignore everything inside it by default
!/.config
/.config/*

# then whitelist what you want
!/.config/yasb
/.config/yasb/*
!/.config/yasb/styles.css
!/.config/yasb/config.yaml
!/.config/whkdrc
!komorebi.json
!applications.json
!win.ahk
!README.md
!setup.ps1